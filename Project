<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contact Developer Support</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f8f9fa;
      color: #333333;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      margin: 0;
      padding: 20px;
    }
    .card {
      background: #ffffff;
      border: 1px solid #e1e4e8;
      width: 100%;
      max-width: 500px;
      padding: 30px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }
    h2 {
      font-size: 18px;
      font-weight: bold;
      margin-top: 0;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    p {
      font-size: 14px;
      line-height: 1.6;
      color: #555555;
    }
    .button-container {
      margin-top: 25px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .btn {
      display: block;
      background-color: #000000;
      color: #ffffff;
      text-align: center;
      padding: 14px 20px;
      text-decoration: none;
      font-size: 14px;
      font-weight: bold;
      text-transform: uppercase;
      border-radius: 0px;
      border: none;
      transition: background-color 0.2s ease;
    }
    .btn:hover {
      background-color: #222222;
